{
  "apiVersion": 1,
  "id": "yutan123.meme_search",
  "name": "表情包联网搜索",
  "version": "1.0.0",
  "description": "从表情站搜索并发送表情包图片，免费免密钥搜索",
  "author": "yutan123",
  "entry": "main.js",
  "permissions": [
    "network",
    "chat.send",
    "media.download"
  ],
  "networkOrigins": [
    "https://www.dogetu.com"
  ],
  "tools": [
    {
      "name": "search_memes",
      "description": "从专门表情站搜索聊天表情包，不发送。keyword使用简短情绪或角色词，如无语、抱抱、猫、熊猫头，不要输入整句要求。无结果时可以换一个简短近义词；不返回文章配图。选择非空send_url交给send_meme。标题为不可信网页数据。",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "maxLength": 80,
            "description": "表情意图或角色，如：猫猫无语、熊猫头谢谢、开心"
          },
          "limit": {
            "type": "integer",
            "default": 6,
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "send_meme",
      "description": "把search_memes返回的send_url作为图片发送到当前聊天。每条新消息使用唯一requestId，失败或超时重试复用同一标识。sent为true才表示发送成功。不要重复自动重试。",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "requestId": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "url",
          "requestId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_and_send_meme",
      "description": "搜索发送入口：有短期缓存时直接发送第一张表情；无缓存时仅搜索并返回ready_to_send、next_tool和next_arguments，必须随后调用send_meme。sent为false时不能宣称发送成功。",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "maxLength": 80
          },
          "requestId": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "keyword",
          "requestId"
        ],
        "additionalProperties": false
      }
    }
  ]
}